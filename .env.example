# Strava personal API application credentials.
# Create an app at https://www.strava.com/settings/api to obtain the client id
# and secret. The refresh token is produced by `runlog strava auth`.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=

# Optional: override the local data directory (defaults to ./data).
# RUNLOG_DATA_DIR=/absolute/path/to/data

# Required only for `runlog plan` (the AI training-plan generator).
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Athlete profile (optional). Prefer data/athlete.toml (see athlete.toml.example),
# which every command reads; these env vars are a fallback with the same keys.
# Demographics feed the energy section (all three required, or it is omitted);
# hr_max / hr_rest anchor the HR zones so you no longer pass --hr-max each time.
# RUNLOG_ATHLETE_SEX=male
# RUNLOG_ATHLETE_HEIGHT_CM=177
# RUNLOG_ATHLETE_BIRTH_DATE=1999-06-07
# RUNLOG_HR_MAX=190
# RUNLOG_HR_REST=50
