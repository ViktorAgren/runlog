# Strava personal API application credentials.
# Create an app at https://www.strava.com/settings/api to obtain the client id
# and secret. The refresh token is produced by `runlog strava auth`.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=

# Optional: override the local data directory (defaults to ./data).
# RUNLOG_DATA_DIR=/absolute/path/to/data

# Required only for `runlog plan` (the AI training-plan generator).
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: demographics for energy-expenditure estimates (BMR / TDEE).
# All three are required for the estimate; leave unset to omit the energy
# section from the report.
# RUNLOG_ATHLETE_SEX=male
# RUNLOG_ATHLETE_HEIGHT_CM=177
# RUNLOG_ATHLETE_BIRTH_DATE=1999-06-07
