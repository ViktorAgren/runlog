<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ model.title }}</title>
<style>
  :root {
    --ink: #0f172a; --subtle: #64748b; --muted: #94a3b8;
    --line: #e2e8f0; --bg: #f8fafc; --card: #ffffff;
    --primary: #2563eb; --good: #16a34a; --warn: #d97706; --bad: #dc2626;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0; background: var(--bg); color: var(--ink);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
      "Helvetica Neue", Arial, sans-serif;
    line-height: 1.5;
  }
  .wrap { max-width: 1100px; margin: 0 auto; padding: 32px 24px 64px; }
  header { border-bottom: 1px solid var(--line); padding-bottom: 20px; margin-bottom: 28px; }
  h1 { font-size: 28px; margin: 0 0 4px; letter-spacing: -0.02em; }
  .sub { color: var(--subtle); font-size: 15px; }
  .gen { color: var(--muted); font-size: 12px; margin-top: 6px; }
  .kpis {
    display: grid; gap: 14px; margin: 28px 0 8px;
    grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
  }
  .kpi {
    background: var(--card); border: 1px solid var(--line); border-radius: 12px;
    padding: 16px 18px; border-left: 4px solid var(--muted);
  }
  .kpi.good { border-left-color: var(--good); }
  .kpi.warn { border-left-color: var(--warn); }
  .kpi.bad  { border-left-color: var(--bad); }
  .kpi .k-label { color: var(--subtle); font-size: 12px; text-transform: uppercase;
    letter-spacing: 0.04em; }
  .kpi .k-value { font-size: 26px; font-weight: 700; margin: 4px 0 2px; }
  .kpi .k-unit { font-size: 14px; font-weight: 500; color: var(--subtle); margin-left: 3px; }
  .kpi .k-context { color: var(--subtle); font-size: 12.5px; }
  section { margin-top: 40px; }
  h2 { font-size: 20px; margin: 0 0 6px; letter-spacing: -0.01em; }
  .narrative { color: var(--subtle); font-size: 15px; margin: 0 0 18px; max-width: 70ch; }
  .figs { display: grid; gap: 22px; grid-template-columns: repeat(auto-fit, minmax(420px, 1fr)); }
  figure { margin: 0; background: var(--card); border: 1px solid var(--line);
    border-radius: 12px; padding: 12px; }
  figure img { width: 100%; height: auto; display: block; border-radius: 6px; }
  figcaption { color: var(--subtle); font-size: 12.5px; margin-top: 8px; }
  footer { margin-top: 48px; padding-top: 16px; border-top: 1px solid var(--line);
    color: var(--muted); font-size: 12px; }
  table.stats { border-collapse: collapse; width: 100%; font-size: 13px;
    background: var(--card); border: 1px solid var(--line); border-radius: 12px; }
  table.stats th { text-align: left; color: var(--subtle); font-size: 11.5px;
    text-transform: uppercase; letter-spacing: 0.04em; padding: 10px 12px;
    border-bottom: 1px solid var(--line); }
  table.stats td { padding: 8px 12px; border-bottom: 1px solid var(--line); }
  table.stats td.num { font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 12.5px; white-space: nowrap; }
  table.stats tr.sig td:first-child { border-left: 3px solid var(--good); }
  table.stats tr:last-child td { border-bottom: none; }
  .stats-caption { color: var(--subtle); font-size: 12.5px; margin: 6px 0 14px; }
</style>
</head>
<body>
<div class="wrap">
  <header>
    <h1>{{ model.title }}</h1>
    <div class="sub">{{ model.subtitle }}</div>
    <div class="gen">Generated {{ model.generated_at }}</div>
  </header>

  {% if model.kpis %}
  <div class="kpis">
    {% for kpi in model.kpis %}
    <div class="kpi {{ kpi.tone }}">
      <div class="k-label">{{ kpi.label }}</div>
      <div class="k-value">{{ kpi.value }}{% if kpi.unit %}<span class="k-unit">{{ kpi.unit }}</span>{% endif %}</div>
      {% if kpi.context %}<div class="k-context">{{ kpi.context }}</div>{% endif %}
    </div>
    {% endfor %}
  </div>
  {% endif %}

  {% if model.stats %}
  <section>
    <h2>What matters (FDR-corrected)</h2>
    <p class="stats-caption">{{ model.stats.caption }}</p>
    <table class="stats">
      <tr><th>Finding</th><th>Lane</th><th>Effect</th><th>95% CI</th>
          <th>p</th><th>q</th><th>n</th></tr>
      {% for row in model.stats.rows %}
      <tr{% if row.significant %} class="sig"{% endif %}>
        <td>{{ row.label }}</td><td>{{ row.lane }}</td>
        <td class="num">{{ row.effect }}</td><td class="num">{{ row.ci }}</td>
        <td class="num">{{ row.p }}</td><td class="num">{{ row.q }}</td>
        <td class="num">{{ row.n }}</td>
      </tr>
      {% endfor %}
    </table>
  </section>
  {% endif %}

  {% for section in sections %}
  <section>
    <h2>{{ section.title }}</h2>
    {% if section.narrative %}<p class="narrative">{{ section.narrative }}</p>{% endif %}
    <div class="figs">
      {% for fig in section.figures %}
      <figure>
        <img src="{{ fig.data_uri }}" alt="{{ fig.title }}">
        {% if fig.caption %}<figcaption>{{ fig.caption }}</figcaption>{% endif %}
      </figure>
      {% endfor %}
    </div>
  </section>
  {% endfor %}

  <footer>runlog · self-contained analytics report · figures embedded inline</footer>
</div>
</body>
</html>
