<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ model.title }}</title>
<style>
  :root {
    --paper: #fbfaf7; --surface: #ffffff; --ink: #1b1b1a; --sub: #5c5b57;
    --muted: #8a8984; --line: #e6e3db; --line-strong: #d4d0c6;
    --accent: #1d4ed8; --good: #15803d; --warn: #b45309; --bad: #b91c1c;
    --sig: #15803d; --shadow: 0 1px 2px rgba(20,20,19,0.04);
    --serif: "Iowan Old Style", "Palatino Linotype", Palatino, Georgia, serif;
    --sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
    --mono: ui-monospace, SFMono-Regular, Menlo, "Roboto Mono", monospace;
  }
  :root:not([data-theme="light"]) {
    @media (prefers-color-scheme: dark) {
      --paper: #15171c; --surface: #1b1e25; --ink: #e7e6e2; --sub: #a8a79f;
      --muted: #74736c; --line: #2a2e37; --line-strong: #3a3f4a;
      --accent: #7aa2ff; --good: #4ade80; --warn: #fbbf24; --bad: #f87171;
      --sig: #4ade80; --shadow: 0 1px 2px rgba(0,0,0,0.3);
    }
  }
  :root[data-theme="dark"] {
    --paper: #15171c; --surface: #1b1e25; --ink: #e7e6e2; --sub: #a8a79f;
    --muted: #74736c; --line: #2a2e37; --line-strong: #3a3f4a;
    --accent: #7aa2ff; --good: #4ade80; --warn: #fbbf24; --bad: #f87171;
    --sig: #4ade80; --shadow: 0 1px 2px rgba(0,0,0,0.3);
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--paper); color: var(--ink);
    font-family: var(--sans); line-height: 1.6; font-size: 16px;
    -webkit-font-smoothing: antialiased; }
  .wrap { max-width: 1140px; margin: 0 auto; padding: 40px 28px 80px; }
  header { display: flex; justify-content: space-between; align-items: flex-start;
    gap: 16px; border-bottom: 2px solid var(--ink); padding-bottom: 18px; }
  h1 { font-family: var(--serif); font-weight: 600; font-size: 30px; line-height: 1.15;
    margin: 0 0 6px; letter-spacing: -0.01em; }
  .sub { color: var(--sub); font-size: 15.5px; }
  .gen { color: var(--muted); font-size: 12.5px; margin-top: 6px; font-family: var(--mono); }
  .provenance { color: var(--muted); font-size: 12.5px; margin: 8px 0 0; }
  .theme-btn { flex: none; appearance: none; border: 1px solid var(--line-strong);
    background: var(--surface); color: var(--sub); border-radius: 8px; cursor: pointer;
    font-size: 13px; padding: 6px 12px; font-family: var(--sans); }
  nav.tabs { display: flex; gap: 4px; margin: 20px 0 8px; border-bottom: 1px solid var(--line); }
  .tab { appearance: none; border: none; background: none; color: var(--sub);
    font-size: 14px; font-weight: 600; padding: 9px 14px; cursor: pointer;
    border-bottom: 2px solid transparent; margin-bottom: -1px; font-family: var(--sans); }
  .tab.active { color: var(--accent); border-bottom-color: var(--accent); }
  .abstract { background: var(--surface); border: 1px solid var(--line);
    border-left: 3px solid var(--accent); border-radius: 8px; padding: 18px 22px;
    margin: 28px 0; box-shadow: var(--shadow); max-width: 80ch; }
  .abstract h2 { font-family: var(--serif); font-size: 15px; text-transform: uppercase;
    letter-spacing: 0.08em; color: var(--sub); margin: 0 0 10px; font-weight: 600; }
  .abstract p { margin: 0; font-size: 15px; line-height: 1.7; color: var(--ink); }
  h2.sec { font-family: var(--serif); font-weight: 600; font-size: 21px;
    margin: 0 0 4px; letter-spacing: -0.01em; }
  .sec-num { color: var(--muted); font-variant-numeric: tabular-nums; margin-right: 8px; }
  section { margin-top: 44px; }
  .results h2.sec { color: var(--ink); }
  .results, table.stats { max-width: 880px; }
  .narrative { color: var(--sub); font-size: 15px; margin: 2px 0 20px; max-width: 72ch; }
  .kpis { display: grid; gap: 12px; margin: 16px 0;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); }
  .kpi { background: var(--surface); border: 1px solid var(--line); border-radius: 10px;
    padding: 14px 16px; border-top: 3px solid var(--muted); box-shadow: var(--shadow); }
  .kpi.good { border-top-color: var(--good); }
  .kpi.warn { border-top-color: var(--warn); }
  .kpi.bad  { border-top-color: var(--bad); }
  .kpi .k-label { color: var(--sub); font-size: 11.5px; text-transform: uppercase;
    letter-spacing: 0.05em; }
  .kpi .k-value { font-size: 25px; font-weight: 700; margin: 4px 0 2px;
    font-variant-numeric: tabular-nums; }
  .kpi .k-unit { font-size: 13px; font-weight: 500; color: var(--sub); margin-left: 3px; }
  .kpi .k-context { color: var(--sub); font-size: 12.5px; }
  .kpi .k-delta { font-size: 12px; font-weight: 600; margin-top: 2px; }
  .kpi .k-delta.good { color: #16a34a; } .kpi .k-delta.bad { color: #dc2626; }
  .kpi .k-delta.flat { color: var(--muted); font-weight: 500; }
  .figs { display: grid; gap: 34px; grid-template-columns: 1fr; }
  figure { margin: 0; background: var(--surface); border: 1px solid var(--line);
    border-radius: 10px; padding: 14px 14px 10px; box-shadow: var(--shadow); }
  figure .svg-fig { width: 100%; }
  figure .svg-fig svg { width: 100%; height: auto; display: block; }
  figcaption { color: var(--sub); font-size: 12.5px; margin-top: 10px;
    padding-top: 8px; border-top: 1px solid var(--line); }
  figcaption .figlabel { font-weight: 700; color: var(--ink); }
  table.stats { border-collapse: collapse; width: 100%; font-size: 13px;
    background: var(--surface); border: 1px solid var(--line); border-radius: 10px;
    overflow: hidden; box-shadow: var(--shadow); }
  table.stats th { text-align: left; color: var(--sub); font-size: 11px;
    text-transform: uppercase; letter-spacing: 0.05em; padding: 11px 13px;
    border-bottom: 2px solid var(--line-strong); }
  table.stats td { padding: 9px 13px; border-bottom: 1px solid var(--line); }
  table.stats td.num { font-family: var(--mono); font-size: 12px; white-space: nowrap;
    font-variant-numeric: tabular-nums; }
  table.stats tr.sig td:first-child { border-left: 3px solid var(--sig); font-weight: 600; }
  table.stats tr:last-child td { border-bottom: none; }
  .stats-caption { color: var(--sub); font-size: 12.5px; margin: 6px 0 14px; }
  .methods { margin-top: 48px; padding-top: 10px; }
  .methods dl { display: grid; grid-template-columns: max-content 1fr; gap: 6px 18px;
    font-size: 13.5px; margin: 10px 0 0; }
  .methods dt { font-weight: 700; color: var(--ink); }
  .methods dd { margin: 0; color: var(--sub); }
  .methods .refs { color: var(--muted); font-size: 12px; margin-top: 18px; line-height: 1.7; }
  footer { margin-top: 56px; padding-top: 16px; border-top: 1px solid var(--line);
    color: var(--muted); font-size: 12px; }
  /* Activities tab */
  @media (max-width: 900px) {
    .figs { grid-template-columns: 1fr; } header { flex-direction: column; } }
  .acts-scroll { max-height: 72vh; overflow: auto; border: 1px solid var(--line);
    border-radius: 10px; background: var(--surface); }
  table.acts { border-collapse: collapse; width: 100%; font-size: 13px; }
  table.acts th { position: sticky; top: 0; background: var(--surface); text-align: left;
    color: var(--sub); font-size: 11px; text-transform: uppercase; letter-spacing: 0.03em;
    padding: 9px 10px; border-bottom: 2px solid var(--line-strong); cursor: pointer;
    white-space: nowrap; }
  table.acts td { padding: 8px 10px; border-bottom: 1px solid var(--line); white-space: nowrap; }
  table.acts td.num { font-variant-numeric: tabular-nums; }
  table.acts tbody tr { cursor: pointer; }
  table.acts tbody tr:hover { background: var(--paper); }
  table.acts tbody tr.sel { background: color-mix(in srgb, var(--accent) 14%, transparent); }
  table.acts th.srt-a::after { content: " \25B2"; } table.acts th.srt-d::after { content: " \25BC"; }
  .badge { font-size: 10px; padding: 1px 5px; border-radius: 6px; font-weight: 700;
    margin-left: 5px; vertical-align: middle; }
  .badge.pr { background: #eab308; color: #1a1a1a; }
  .badge.off { background: #dc2626; color: #fff; }
  .ibar { display: inline-flex; height: 8px; width: 72px; border-radius: 999px;
    overflow: hidden; background: var(--line); vertical-align: middle; }
  .ibar span { display: block; height: 100%; }
  .ibar .e { background: #16a34a; } .ibar .m { background: #eab308; } .ibar .h { background: #dc2626; }
  .acts-summary { font-size: 13px; color: var(--sub); margin: 2px 0 8px;
    font-variant-numeric: tabular-nums; }
  .modal-backdrop { position: fixed; inset: 0; z-index: 50; display: none;
    background: rgba(12, 12, 15, 0.55); padding: 3vh 2vw;
    align-items: stretch; justify-content: center; }
  .modal-backdrop[open] { display: flex; }
  .modal { position: relative; width: min(1180px, 96vw); max-height: 94vh;
    background: var(--surface); border: 1px solid var(--line-strong);
    border-radius: 12px; box-shadow: 0 24px 60px rgba(0,0,0,0.35);
    overflow: hidden; display: flex; flex-direction: column; }
  .modal-close { position: absolute; top: 10px; right: 12px; z-index: 2; appearance: none;
    width: 34px; height: 34px; border-radius: 8px; border: 1px solid var(--line-strong);
    background: var(--surface); color: var(--sub); font-size: 18px; line-height: 1;
    cursor: pointer; }
  .modal-close:hover { color: var(--ink); }
  .detail-frame { flex: 1; width: 100%; border: 0; background: var(--surface); }
  .hint { color: var(--muted); font-size: 12.5px; padding: 10px 2px; }
  .filters { display: flex; gap: 16px; margin-bottom: 10px; align-items: center;
    font-size: 13px; color: var(--sub); }
  .filters select { font-size: 13px; padding: 4px 8px; border: 1px solid var(--line);
    border-radius: 8px; background: var(--surface); color: var(--ink); margin-left: 4px; }
</style>
</head>
<body>
<div class="wrap">
  <header>
    <div>
      <h1>{{ model.title }}</h1>
      <div class="sub">{{ model.subtitle }}</div>
      <div class="gen">Generated {{ model.generated_at }}</div>
    </div>
    <button class="theme-btn" onclick="toggleTheme()" id="theme-btn">◐ Theme</button>
  </header>

  <nav class="tabs">
    <button class="tab active" data-tab="overview" onclick="showTab('overview')">Report</button>
    <button class="tab" data-tab="activities" onclick="showTab('activities')">Activities</button>
  </nav>

  <div id="overview" class="panel">
    {% if model.summary %}
    <div class="abstract">
      <h2>Training status</h2>
      <p>{{ model.summary }}</p>
      {% if model.provenance %}
      <p class="provenance">{{ model.provenance }}</p>
      {% endif %}
    </div>
    {% endif %}

    {% if model.stats and model.stats.rows %}
    <section class="results">
      <h2 class="sec">Results — what matters</h2>
      <p class="stats-caption">{{ model.stats.caption }}</p>
      <table class="stats">
        <tr><th>Finding</th><th>Lane</th><th>Effect</th><th>95% CI</th>
            <th>p</th><th>q</th><th>n</th></tr>
        {% for row in model.stats.rows %}
        <tr{% if row.significant %} class="sig"{% endif %}>
          <td>{{ row.label }}</td><td>{{ row.lane }}</td>
          <td class="num">{{ row.effect }}</td><td class="num">{{ row.ci }}</td>
          <td class="num">{{ row.p }}</td><td class="num">{{ row.q }}</td>
          <td class="num">{{ row.n }}</td>
        </tr>
        {% endfor %}
      </table>
    </section>
    {% endif %}

    {% if model.kpis %}
    <section>
      <h2 class="sec">At a glance</h2>
      <div class="kpis">
        {% for kpi in model.kpis %}
        <div class="kpi {{ kpi.tone }}">
          <div class="k-label">{{ kpi.label }}</div>
          <div class="k-value">{{ kpi.value }}{% if kpi.unit %}<span class="k-unit">{{ kpi.unit }}</span>{% endif %}</div>
          {% if kpi.context %}<div class="k-context">{{ kpi.context }}</div>{% endif %}
          {% if kpi.delta %}<div class="k-delta {{ kpi.delta_dir }}">{{ kpi.delta }}</div>{% endif %}
        </div>
        {% endfor %}
      </div>
    </section>
    {% endif %}

    {% for section in sections %}
    <section>
      <h2 class="sec"><span class="sec-num">{{ loop.index }}</span>{{ section.title }}</h2>
      {% if section.narrative %}<p class="narrative">{{ section.narrative }}</p>{% endif %}
      <div class="figs">
        {% for fig in section.figures %}
        <figure>
          <div class="svg-fig">{{ fig.svg|safe }}</div>
          <figcaption><span class="figlabel">Figure {{ loop.index }}. {{ fig.title }}.</span>{% if fig.caption %} {{ fig.caption }}{% endif %}</figcaption>
        </figure>
        {% endfor %}
      </div>
    </section>
    {% endfor %}

    <section class="methods">
      <h2 class="sec">Methods &amp; definitions</h2>
      <p class="narrative">Every trend is tested once as a family and corrected for
        multiple comparisons (Benjamini-Hochberg FDR); a finding is flagged only
        when its q-value clears the threshold. Confidence intervals use the exact
        Student-t distribution.</p>
      <dl>
        <dt>Critical Speed (CS) &amp; D′</dt><dd>Sustainable-speed asymptote and the finite distance available above it, from the 2-parameter critical-power model.</dd>
        <dt>Mean-maximal curve</dt><dd>Fastest average speed held for each duration, across all runs — the running power-duration curve.</dd>
        <dt>VDOT</dt><dd>VO₂max-equivalent race fitness (Daniels-Gilbert), from the modelled 5 km.</dd>
        <dt>Polarization Index</dt><dd>log₁₀(Z1·Z3/Z2) on easy/moderate/hard shares; &gt; 2.0 is polarized (Treff 2019).</dd>
        <dt>Durability</dt><dd>Percent efficiency fade from the fresh first third to the fatigued last third of long runs (Jones 2023).</dd>
        <dt>Monotony / Strain</dt><dd>Weekly mean÷SD of daily load, and that times weekly load (Foster 1998).</dd>
        <dt>PMC (CTL / ATL / Form)</dt><dd>Fitness, fatigue and form as exponentially-weighted TRIMP (Banister).</dd>
        <dt>ACWR</dt><dd>Acute:chronic workload ratio — shown with the caveat that the ratio is spuriously coupled.</dd>
        <dt>Efficiency factor</dt><dd>Speed per heart beat; its trend tracks aerobic efficiency.</dd>
      </dl>
      <div class="refs">
        Jones AM (2023), <em>J Physiol</em>. Treff et al. (2019), <em>Front Physiol</em>.
        Foster C (1998), <em>Med Sci Sports Exerc</em>. Daniels &amp; Gilbert, <em>Oxygen Power</em>.
        Benjamini &amp; Hochberg (1995), <em>J R Stat Soc B</em>.
      </div>
    </section>
  </div>

  <div id="activities" class="panel" hidden>
    {% if model.activities %}
    <div>
        <div class="filters">
          <label>Show
            <select id="f-indoor" onchange="applyFilters()">
              <option value="">all</option>
              <option value="out">outdoor</option>
              <option value="in">indoor</option>
            </select>
          </label>
          <label>Type
            <select id="f-session" onchange="applyFilters()">
              <option value="">all</option>
              {% for s in model.activities|map(attribute='session')|unique|sort %}
              <option value="{{ s }}">{{ s }}</option>
              {% endfor %}
            </select>
          </label>
          <label>Search
            <input id="f-search" type="search" oninput="applyFilters()"
              placeholder="date / session / source" autocomplete="off">
          </label>
        </div>
        <div class="acts-summary" id="acts-summary"></div>
        <div class="acts-scroll">
          <table class="acts" id="acts">
            <thead><tr>
              <th onclick="sortActs(0,'t')">Date</th>
              <th onclick="sortActs(1,'t')">Day</th>
              <th onclick="sortActs(2,'t')">Type</th>
              <th onclick="sortActs(3,'t')">Session</th>
              <th onclick="sortActs(4,'t')">Source</th>
              <th onclick="sortActs(5,'n')">Dist</th>
              <th onclick="sortActs(6,'n')">Time</th>
              <th onclick="sortActs(7,'n')">Pace</th>
              <th onclick="sortActs(8,'n')" title="grade-adjusted pace">GAP</th>
              <th onclick="sortActs(9,'n')">Avg HR</th>
              <th onclick="sortActs(10,'n')">Max HR</th>
              <th onclick="sortActs(11,'n')" title="Banister TRIMP">Load</th>
              <th onclick="sortActs(12,'n')" title="efficiency factor: m/min per bpm">EF</th>
              <th onclick="sortActs(13,'n')" title="HR-pace decoupling">Decoup</th>
              <th onclick="sortActs(14,'n')" title="easy / moderate / hard time">Int</th>
              <th onclick="sortActs(15,'n')">Cad</th>
              <th onclick="sortActs(16,'n')">Elev</th>
              <th onclick="sortActs(17,'n')">kcal</th>
            </tr></thead>
            <tbody>
            {% for a in model.activities %}
            <tr data-indoor="{{ 1 if a.indoor else 0 }}" data-session="{{ a.session }}"
                data-text="{{ (a.date ~ ' ' ~ a.session ~ ' ' ~ a.source ~ ' ' ~ a.sport)|lower }}"
                data-dist="{{ a.distance_km }}" data-dur="{{ a.duration_s }}"
                data-load="{{ a.load or 0 }}" data-hr="{{ a.avg_hr or 0 }}"
                data-pacekey="{{ a.pace_s or 0 }}" onclick="openActivity('{{ a.page }}', this)">
              <td>{{ a.date }}</td>
              <td>{{ a.weekday }}</td>
              <td>{{ a.sport }}</td>
              <td>{{ a.session }}{% if a.is_pr %}<span class="badge pr">PR</span>{% endif %}{% if a.is_off %}<span class="badge off">off</span>{% endif %}</td>
              <td>{{ a.source }}</td>
              <td class="num" data-sort="{{ a.distance_km }}">{{ '%.2f'|format(a.distance_km) }}</td>
              <td class="num" data-sort="{{ a.duration_s or '' }}">{{ a.duration_disp }}</td>
              <td class="num" data-sort="{{ a.pace_s or '' }}">{{ a.pace_disp }}</td>
              <td class="num" data-sort="{{ a.gap_s if a.gap_s is not none else '' }}">{{ a.gap_disp }}</td>
              <td class="num" data-sort="{{ a.avg_hr or '' }}">{{ a.avg_hr if a.avg_hr is not none else '-' }}</td>
              <td class="num" data-sort="{{ a.max_hr or '' }}">{{ a.max_hr if a.max_hr is not none else '-' }}</td>
              <td class="num" data-sort="{{ a.load if a.load is not none else '' }}">{{ a.load if a.load is not none else '-' }}</td>
              <td class="num" data-sort="{{ a.ef if a.ef is not none else '' }}">{{ '%.2f'|format(a.ef) if a.ef is not none else '-' }}</td>
              <td class="num" data-sort="{{ a.decoupling_pct if a.decoupling_pct is not none else '' }}">{{ '%+.1f'|format(a.decoupling_pct) if a.decoupling_pct is not none else '-' }}</td>
              <td data-sort="{{ a.hard_pct if a.hard_pct is not none else '' }}">{% if a.easy_pct is not none %}<span class="ibar" title="Easy {{ a.easy_pct|round|int }}% · Mod {{ a.moderate_pct|round|int }}% · Hard {{ a.hard_pct|round|int }}%"><span class="e" style="width:{{ a.easy_pct }}%"></span><span class="m" style="width:{{ a.moderate_pct }}%"></span><span class="h" style="width:{{ a.hard_pct }}%"></span></span>{% else %}-{% endif %}</td>
              <td class="num" data-sort="{{ a.cadence or '' }}">{{ a.cadence if a.cadence is not none else '-' }}</td>
              <td class="num" data-sort="{{ a.elevation_m or '' }}">{{ a.elevation_m if a.elevation_m is not none else '-' }}</td>
              <td class="num" data-sort="{{ a.calories or '' }}">{{ a.calories if a.calories is not none else '-' }}</td>
            </tr>
            {% endfor %}
            </tbody>
          </table>
        </div>
        <div class="hint" id="acts-hint">click a row to open its timeline · click a column to sort</div>
    </div>
    <div class="modal-backdrop" id="detail-modal" onclick="if (event.target === this) closeDetail()">
      <div class="modal">
        <button class="modal-close" onclick="closeDetail()" aria-label="Close detail">&times;</button>
        <iframe id="detail-frame" class="detail-frame" title="workout detail"></iframe>
      </div>
    </div>
    {% else %}
    <p class="narrative">No activities to list.</p>
    {% endif %}
  </div>

  <footer>runlog · self-contained analytics report · vector figures embedded inline</footer>
</div>
<script>
  function toggleTheme() {
    var cur = document.documentElement.getAttribute('data-theme');
    var dark = cur ? cur === 'dark'
      : window.matchMedia('(prefers-color-scheme: dark)').matches;
    document.documentElement.setAttribute('data-theme', dark ? 'light' : 'dark');
    try { localStorage.setItem('runlog-theme', dark ? 'light' : 'dark'); } catch (e) {}
  }
  try {
    var saved = localStorage.getItem('runlog-theme');
    if (saved) document.documentElement.setAttribute('data-theme', saved);
  } catch (e) {}
  function showTab(id) {
    document.querySelectorAll('.panel').forEach(function (p) { p.hidden = p.id !== id; });
    document.querySelectorAll('.tab').forEach(function (b) {
      b.classList.toggle('active', b.dataset.tab === id);
    });
  }
  function currentTheme() {
    var t = document.documentElement.getAttribute('data-theme');
    if (t) return t;
    return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  }
  function openActivity(page, row) {
    var frame = document.getElementById('detail-frame');
    if (frame) frame.src = page + '#' + currentTheme();
    var modal = document.getElementById('detail-modal');
    if (modal) modal.setAttribute('open', '');
    document.querySelectorAll('#acts tbody tr').forEach(function (r) { r.classList.remove('sel'); });
    row.classList.add('sel');
  }
  function closeDetail() {
    var modal = document.getElementById('detail-modal');
    if (modal) modal.removeAttribute('open');
  }
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') closeDetail();
  });
  function fmtClock(s) {
    s = Math.round(s); var h = Math.floor(s / 3600), m = Math.floor((s % 3600) / 60);
    return h ? h + 'h ' + m + 'm' : m + 'm';
  }
  function fmtPace(s) {
    s = Math.round(s); return Math.floor(s / 60) + ':' + ('0' + (s % 60)).slice(-2);
  }
  function updateSummary() {
    var n = 0, dist = 0, dur = 0, load = 0, hrSum = 0, hrN = 0;
    document.querySelectorAll('#acts tbody tr').forEach(function (r) {
      if (r.hidden) return;
      n++;
      dist += parseFloat(r.dataset.dist) || 0;
      dur += parseFloat(r.dataset.dur) || 0;
      load += parseFloat(r.dataset.load) || 0;
      var hr = parseFloat(r.dataset.hr) || 0; if (hr > 0) { hrSum += hr; hrN++; }
    });
    var el = document.getElementById('acts-summary');
    if (!el) return;
    var parts = [n + ' runs', dist.toFixed(1) + ' km', fmtClock(dur), 'load ' + Math.round(load)];
    if (dist > 0 && dur > 0) parts.push('avg ' + fmtPace(dur / (dist)) + '/km');
    if (hrN) parts.push('avg HR ' + Math.round(hrSum / hrN));
    el.textContent = parts.join('  ·  ');
  }
  function applyFilters() {
    if (!document.getElementById('acts')) return;
    var ind = document.getElementById('f-indoor').value;
    var ses = document.getElementById('f-session').value;
    var q = (document.getElementById('f-search').value || '').trim().toLowerCase();
    document.querySelectorAll('#acts tbody tr').forEach(function (r) {
      var okInd = !ind || (ind === 'in') === (r.dataset.indoor === '1');
      var okSes = !ses || r.dataset.session === ses;
      var okQ = !q || (r.dataset.text || '').indexOf(q) !== -1;
      r.hidden = !(okInd && okSes && okQ);
    });
    updateSummary();
  }
  var sortDir = {}, sortCol = null;
  function sortActs(col, type) {
    var body = document.querySelector('#acts tbody');
    if (!body) return;
    var dir = sortDir[col] = -(sortDir[col] || 1);
    var rows = Array.prototype.slice.call(body.rows);
    rows.sort(function (a, b) {
      if (type === 'n') {
        var x = parseFloat(a.cells[col].dataset.sort), y = parseFloat(b.cells[col].dataset.sort);
        var ax = isNaN(x), ay = isNaN(y);           // blanks always sort last
        if (ax && ay) return 0; if (ax) return 1; if (ay) return -1;
        return x < y ? dir : x > y ? -dir : 0;
      }
      var p = a.cells[col].textContent, r = b.cells[col].textContent;
      return p < r ? dir : p > r ? -dir : 0;
    });
    rows.forEach(function (r) { body.appendChild(r); });
    document.querySelectorAll('#acts th').forEach(function (h) { h.classList.remove('srt-a', 'srt-d'); });
    var th = document.querySelectorAll('#acts th')[col];
    if (th) th.classList.add(dir > 0 ? 'srt-a' : 'srt-d');
    sortCol = col;
  }
  applyFilters();
</script>
</body>
</html>
